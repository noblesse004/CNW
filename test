<?php
require_once APP_ROOT . '/app/models/Patient.php';
require_once APP_ROOT . '/app/libs/DbConnection.php';

class PatientService {

    // 1. Lấy tất cả bệnh nhân
    public function getAllPatients() {
        $patients = [];
        $dbConnection = new DBConnection();
        $conn = $dbConnection->getConnection();

        if ($conn != null) {
            $sql = "SELECT * FROM patients ORDER BY id DESC";
            $stmt = $conn->query($sql);

            while ($row = $stmt->fetch()) {
                // SỬA: Truyền thêm $row['phone_number'] vào class Patient
                $patient = new Patient($row['id'], $row['name'], $row['gender'], $row['phone_number']);
                $patients[] = $patient;
            }
        }
        return $patients;
    }

    // 2. Lấy bệnh nhân theo ID
    public function getPatientById($id) {
        $dbConnection = new DBConnection();
        $conn = $dbConnection->getConnection();

        if ($conn != null) {
            $sql = "SELECT * FROM patients WHERE id = :id";
            $stmt = $conn->prepare($sql);
            $stmt->execute(['id' => $id]);
            $row = $stmt->fetch();

            if ($row) {
                // SỬA: Truyền thêm $row['phone_number'] vào class Patient
                return new Patient($row['id'], $row['name'], $row['gender'], $row['phone_number']);
            }
        }
        return null;
    }

    // 3. Thêm mới bệnh nhân
    // SỬA: Thêm tham số $phoneNumber vào hàm
    public function addPatient($name, $gender, $phoneNumber) {
        $dbConnection = new DBConnection();
        $conn = $dbConnection->getConnection();

        if ($conn != null) {
            // SỬA: Thêm cột phone_number vào câu lệnh INSERT
            $sql = "INSERT INTO patients (name, gender, phone_number) VALUES (:name, :gender, :phone_number)";
            $stmt = $conn->prepare($sql);
            // SỬA: Truyền thêm biến vào mảng execute
            return $stmt->execute([
                'name' => $name, 
                'gender' => $gender, 
                'phone_number' => $phoneNumber
            ]);
        }
        return false;
    }

    // 4. Cập nhật thông tin bệnh nhân
    // SỬA: Thêm tham số $phoneNumber vào hàm
    public function updatePatient($id, $name, $gender, $phoneNumber) {
        $dbConnection = new DBConnection();
        $conn = $dbConnection->getConnection();

        if ($conn != null) {
            // SỬA: Thêm phone_number = :phone_number vào câu lệnh UPDATE
            $sql = "UPDATE patients SET name = :name, gender = :gender, phone_number = :phone_number WHERE id = :id";
            $stmt = $conn->prepare($sql);
            // SỬA: Truyền thêm biến vào mảng execute
            return $stmt->execute([
                'id' => $id, 
                'name' => $name, 
                'gender' => $gender,
                'phone_number' => $phoneNumber
            ]);
        }
        return false;
    }

    // 5. Xóa bệnh nhân (GIỮ NGUYÊN)
    public function deletePatient($id) {
        $dbConnection = new DBConnection();
        $conn = $dbConnection->getConnection();

        if ($conn != null) {
            $sql = "DELETE FROM patients WHERE id = :id";
            $stmt = $conn->prepare($sql);
            return $stmt->execute(['id' => $id]);
        }
        return false;
    }
}
